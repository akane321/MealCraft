APP_NAME=MealCraft
APP_VERSION=0.1.0
ENVIRONMENT=development

POSTGRES_DB=mealcraft
POSTGRES_USER=mealcraft
POSTGRES_PASSWORD=development_only
POSTGRES_PORT=15432

DATABASE_URL=postgresql+psycopg://mealcraft:development_only@database:5432/mealcraft

BACKEND_PORT=8000
FRONTEND_PORT=3000
NUXT_PUBLIC_API_BASE=http://localhost:8000

FAIRPRICE_BASE_URL=https://www.fairprice.com.sg
FAIRPRICE_TIMEOUT_SECONDS=12
FAIRPRICE_CACHE_TTL_MINUTES=15
PRODUCT_FIXTURE_PATH=data/fixtures/fairprice-products.json

YOUTUBE_TIMEOUT_SECONDS=12
YOUTUBE_FIXTURE_PATH=data/fixtures/youtube-tutorials.json
# YOUTUBE_API_KEY=add_locally_only_when_implementing_live_youtube_search

# The key-free fixture parser is deterministic and used by tests and demos.
AGENT_PARSER_PROVIDER=fixture
# mvp plans seven one-dish dinners; full admits meals of several dishes (ADR-0036).
PLANNING_CAPABILITY=full
# Seconds the planner keeps the candidate recipes it loaded; 0 reloads them for every plan.
PLANNING_POOL_CACHE_SECONDS=300
AGENT_MAX_HISTORY_MESSAGES=20
OPENAI_MODEL=gpt-5.4-mini
# OPENAI_API_KEY=add_locally_only_when_using_openai

# Opaque browser sessions. Secure cookies are automatic outside development/test;
# set AUTH_COOKIE_SECURE explicitly only when the deployment boundary requires it.
AUTH_SESSION_TTL_HOURS=168
AUTH_LAST_SEEN_INTERVAL_SECONDS=300
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_LOCK_MINUTES=15

# Operations console accounts (ADR-0047), created or updated at start-up, all with the same
# highest level: email:password:Display Name;email2:password2:Name2. Set real values locally only.
ADMIN_ACCOUNTS=

# Evaluation remains fixture-only unless a future formal benchmark also passes
# both --agent-provider openai and --allow-live-api explicitly.

# Browser origins allowed by CORS, as a JSON list. The default also admits the
# frontend on FRONTEND_PORT at localhost and 127.0.0.1.
# CORS_ORIGINS=["http://localhost:3000"]
# AUTH_COOKIE_NAME=mealcraft_session
# AUTH_CSRF_COOKIE_NAME=mealcraft_csrf
# AUTH_COOKIE_SECURE=true
