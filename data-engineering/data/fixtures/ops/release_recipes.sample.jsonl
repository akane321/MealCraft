{"allergen_basis": "rule table over canonical ingredients (ADR-0024 section 3); check product labels", "allergens": ["milk"], "cook_minutes": 0, "course": "sauce_condiment", "cuisine": "middle_eastern", "dietary_tags": ["gluten-free", "vegetarian"], "dietary_tags_basis": {"dairy-free": "derived_false", "gluten-free": "derived_true", "vegan": "derived_false", "vegetarian": "derived_true"}, "difficulty": "easy", "enrichment": {"by": "claude/akane321", "confidence": {"course": 0.85, "cuisine": 0.9, "difficulty": 0.95, "meal_types": 0.65, "servings": 0.4, "time": 0.75}, "evidence": {"course": "strained yogurt cheese spread", "cuisine": "labaneh, title says Arabic Yogurt Cheese", "difficulty": "strain and drain only, no cooking", "meal_types": "spread eaten as snack", "servings": "2 quarts yogurt, estimated 8 servings", "time": "step 11: drain 8-24 hr, using 24hr for cream cheese texture"}}, "ingredients": [{"allergens": ["milk"], "canonical_ingredient_id": "ING_YOGURT", "canonical_name": "yogurt", "grams": 1960.0, "grams_basis": "stated", "optional": false, "original_text": "2 quarts yogurt (Non-fat, low-fat, or full-fat are all OK. Pick a brand with a minimal amount of gelatin, pectin, or)", "preparation": ["non-fat, low-fat, or full-fat are all ok. pick a brand with a minimal amount of gelatin, pectin, or"], "quantity_max": 2.0, "quantity_min": 2.0, "unit": "quart"}, {"allergens": [], "canonical_ingredient_id": "ING_SALT", "canonical_name": "salt", "grams": 3.0, "grams_basis": "stated", "optional": true, "original_text": "1/2 teaspoon salt (optional)", "preparation": ["optional"], "quantity_max": 0.5, "quantity_min": 0.5, "unit": "tsp"}, {"allergens": [], "canonical_ingredient_id": "ING_OLIVE_OIL", "canonical_name": "olive oil", "estimate_basis": "optional oil for smoothing yogurt cheese", "grams": 13.5, "grams_basis": "estimated", "optional": true, "original_text": "extra virgin olive oil (very optional)", "preparation": ["extra virgin", "very optional"], "quantity_max": null, "quantity_min": null, "unit": null}], "instructions": [{"step_number": 1, "text": "Although the original recipe doesn't call for non-fat yogurt, non-fat works fine."}, {"step_number": 2, "text": "Some recipes almost demand a little fat to smooth their texture on the tongue."}, {"step_number": 3, "text": "This can be provided by beating a little bit of mayonnaise or olive oil into the non-fat yogurt cheese."}, {"step_number": 4, "text": "It's still fat, but at least it's cholesterol free fat."}, {"step_number": 5, "text": "If you are skinny and don't have to worry about dietary fat, you can use low-fat or whole-milk yogurt, and then you won't have to worry about adding oil."}, {"step_number": 6, "text": "Bring 2 quarts of yogurt to room temperature, and stir thoroughly to smooth and break up all lumps."}, {"step_number": 7, "text": "Optionally, you can add 1/2 Tsp salt (original recipe, we usually don't, because we use this for so many different things)."}, {"step_number": 8, "text": "Line a colander with a couple of dampened paper towels or a clean, dampened, loose weave cotton towel."}, {"step_number": 9, "text": "Pour yogurt into the colander, cover with another paper towel or plastic wrap."}, {"step_number": 10, "text": "Place in the sink, or in a bowl which is small enough to hold the colander away from its bottom."}, {"step_number": 11, "text": "Let drain for about 8 hours for sour cream consistency or for 24 hours for cream cheese consistency; the longer it drains, the thicker it gets."}, {"step_number": 12, "text": "If you are a real freak, you can refrigerate the yogurt while it drains, but it's not really necessary."}, {"step_number": 13, "text": "Yogurt is a living organism; it is cultured in warmth, and it thrives on it (within reason)."}, {"step_number": 14, "text": "Draining will normally reduce the yogurt by about half for sour cream consistency, or by about two-thirds for cream cheese consistency."}, {"step_number": 15, "text": "We normally go all the way to cream cheese consistency and mix in a little low-fat milk if we need it thinner."}], "meal_types": ["snack"], "nutrition": {"basis": "per_serving", "carbohydrate_g": 11.4, "energy_kcal": 164.4, "fat_g": 9.7, "protein_g": 8.5, "sodium_mg": 260.1, "source": "sum of ingredient grams x enriched nutrition per 100 g (ADR-0030)", "status": "computed", "sugar_g": 11.4}, "passive_minutes": 1440, "prep_minutes": 10, "recipe_id": "RCP2_546741690AE1", "schema_version": "mealcraft.recipe.v2", "servings": 8, "servings_basis": "estimated", "source": {"candidate_id": "recipenlg:1166127", "dataset": "RecipeNLG (Gathered)", "license": "RecipeNLG: non-commercial research and educational use only", "source_id": "1166127", "source_revision": null, "source_url": "www.food.com/recipe/yogurt-cheese-labanee-in-arabic-66860"}, "time_basis": "stated", "title": "Yogurt Cheese - 'Labanee', In Arabic", "total_minutes": 1450, "video_url": null}
