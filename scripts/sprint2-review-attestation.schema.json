{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mealcraft:sprint2-review-attestation-v1",
  "title": "Review attestation for one exact authoring file; it never edits the file it attests",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "content_sha256", "fields_sha256", "purpose", "author_id", "recorded_on", "reviewers", "dictionary_review", "cases"],
  "properties": {
    "schema_version": {"const": "sprint2-review-attestation-v1"},
    "content_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "fields_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "purpose": {"const": "freeze_candidate"},
    "author_id": {"$ref": "#/$defs/id"},
    "recorded_on": {"type": "string", "format": "date"},
    "reviewers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reviewer_id", "executed_by"],
        "properties": {
          "reviewer_id": {"$ref": "#/$defs/id"},
          "executed_by": {"enum": ["human", "ai"]}
        }
      }
    },
    "dictionary_review": {"$ref": "#/$defs/review"},
    "cases": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[A-Za-z0-9_-]+$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gold_review", "anonymisation_review"],
        "properties": {
          "gold_review": {"$ref": "#/$defs/review"},
          "anonymisation_review": {"$ref": "#/$defs/review"}
        }
      }
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_id", "status"],
      "properties": {
        "reviewer_id": {"$ref": "#/$defs/id"},
        "status": {"const": "independently_checked"}
      }
    }
  }
}
