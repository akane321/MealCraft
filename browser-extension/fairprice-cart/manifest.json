{
  "manifest_version": 3,
  "name": "MealCraft FairPrice cart",
  "version": "0.1.0",
  "key": "",
  "background": { "service_worker": "background.js" },
  "permissions": ["scripting"],
  "host_permissions": [
    "https://www.fairprice.com.sg/*",
    "https://website-api.omni.fairprice.com.sg/*"
  ],
  "externally_connectable": {
    "matches": ["http://localhost:3000/*", "http://127.0.0.1:3000/*"]
  }
}
